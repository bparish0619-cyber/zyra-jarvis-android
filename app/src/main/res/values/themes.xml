<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Plain dark framework theme, no action bar: the glass identity
         bar in the layout is the header, Jarvis-style. -->
    <style name="Theme.ZyraJarvis" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/jarvis_bg</item>
        <item name="android:statusBarColor">@color/jarvis_bg</item>
        <item name="android:navigationBarColor">@color/jarvis_bg</item>
        <item name="android:colorAccent">@color/jarvis_accent</item>
    </style>
</resources>
