<?xml version="1.0" encoding="utf-8"?>
<!-- HUD control in its ON state (handsfree running): accent wash fill
     plus a solid cyan border, the flat-UI stand-in for the frontend's
     accent glow. Applied from MainActivity.setHandsfree(). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/jarvis_accent_subtle" />
    <stroke android:width="1dp" android:color="@color/jarvis_accent" />
    <corners android:radius="2dp" />
</shape>
