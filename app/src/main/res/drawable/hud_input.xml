<?xml version="1.0" encoding="utf-8"?>
<!-- Composer / settings text field, copied from the frontend's input
     tokens: bg #0c121a, 1dp border rgba(79,209,255,0.12), square-ish
     2dp corners (Jarvis is angular, not pill-shaped). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/jarvis_input_bg" />
    <stroke android:width="1dp" android:color="@color/jarvis_input_border" />
    <corners android:radius="2dp" />
</shape>
