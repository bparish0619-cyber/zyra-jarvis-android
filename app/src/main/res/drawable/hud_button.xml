<?xml version="1.0" encoding="utf-8"?>
<!-- HUD control (TALK, SETUP): raised panel fill, hairline border;
     pressed state fills with the accent's subtle wash. The handsfree
     button's ON state uses hud_button_active instead (set in code). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/jarvis_accent_subtle" />
            <stroke android:width="1dp" android:color="@color/jarvis_accent" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/jarvis_raised" />
            <stroke android:width="1dp" android:color="@color/jarvis_border" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>
