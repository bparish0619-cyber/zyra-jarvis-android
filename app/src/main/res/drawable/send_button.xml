<?xml version="1.0" encoding="utf-8"?>
<!-- Send control: solid Jarvis cyan, brightens to the hover cyan
     while pressed. Text on it uses jarvis_on_accent. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/jarvis_accent_hover" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/jarvis_accent" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>
